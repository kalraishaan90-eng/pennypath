# Supabase Configuration
# These environment variables are required for Supabase backend integration
# NOTE: Only VITE_SUPABASE_ variables are exposed to the client (browser)
# The anon key should be used from Supabase project settings

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Feature flags
VITE_DEMO_MODE_ENABLED=true

# Application settings
VITE_APP_NAME=Pennypath
VITE_APP_VERSION=1.0.0